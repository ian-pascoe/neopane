# The demo panes' shell: a short prompt and nothing else.
PS1='\[\e[36m\]neopane\[\e[0m\] \[\e[35m\]$\[\e[0m\] '
export BASH_SILENCE_DEPRECATION_WARNING=1

# A daemon started here keeps its clipboard in memory (clipboard.vim). The
# tape still types plain `neopane FILE`; command words pass straight on.
demo_clipboard="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/clipboard.vim"
neopane() {
  case "${1:-}" in
  attach | list | status | kill | open | provider | help | version | detach | daemon | \
    config-child | debug-* | -*) command neopane "$@" ;;
  *) command neopane --cmd "source $demo_clipboard" "$@" ;;
  esac
}
